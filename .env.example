# ==============================================================================
# BebshaOS Backend - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and replace the placeholder values with your real secrets.
# NEVER commit .env with real secrets to version control.
# ==============================================================================

# Application Environment (development | production | test)
NODE_ENV=production

# Server Port
PORT=3000

# PostgreSQL Connection String (Isolated local or private container)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bebshaos?schema=public"

# Redis Connection String (for BullMQ queues and caching)
# Format: redis://[USER:PASSWORD@]HOST:PORT
REDIS_URL="redis://localhost:6379"

# CORS Allowed Origins (Comma-separated URLs or * in development)
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# JWT Authentication Secrets (Must be secure, random strings with at least 32 characters)
JWT_ACCESS_SECRET="replace-with-a-secure-random-access-secret-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="replace-with-a-secure-random-refresh-secret-min-32-chars"
JWT_REFRESH_EXPIRES_IN="7d"

# OTP Hashing Secret
OTP_HASH_SECRET="replace-with-a-secure-random-otp-hash-secret-min-32-chars"

# Email Provider Configuration ('console' | 'smtp')
EMAIL_PROVIDER="console"
EMAIL_FROM="noreply@bebshaos.com"

# API Rate Limiting (Throttler)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Platform Administrators (Optional comma-separated lists)
# PLATFORM_ADMIN_EMAILS="admin@bebshaos.com,dev@bebshaos.com"
# PLATFORM_ADMIN_USER_IDS="uuid1,uuid2"
